# Server only. Never prefix secrets with VITE_.
# Claude (Anthropic). If set, Claude is used. Key: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Optional: claude-opus-5-5 (default), claude-sonnet-5-5, claude-haiku-5-5 (cheapest)
CLAUDE_MODEL=claude-opus-5-5
# OpenAI-compatible alternative (used only when ANTHROPIC_API_KEY is empty)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-6-luna
PORT=3000
# Enable only behind exactly one trusted reverse proxy:
TRUST_PROXY=0
